# ============================================================
# ShipSure AI - Environment Configuration Example
# Copy this file to .env and fill in your local values.
# Never commit your real .env file.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
PORT=3000

# ------------------------------------------------------------
# Dataset Source
# DEMO   = synthetic frontend demo data
# LOCAL  = local dataset folder
# DOCKER = official SDOC Docker API
# ------------------------------------------------------------
DATA_SOURCE=DOCKER

# Official SDOC Docker API
DATA_API_URL=http://localhost:8080

# Used when DATA_SOURCE=LOCAL
DATA_PATH=./data

# ------------------------------------------------------------
# Gemini
# Add your real API key only inside .env
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------
# Development
# ------------------------------------------------------------
DISABLE_HMR=true

# ------------------------------------------------------------
# Automatic Inbox Processing
# false is safer as the example default so cloning the repo
# does not immediately consume Gemini quota.
# Set to true in your real .env when required.
# ------------------------------------------------------------
AUTO_PROCESS_NEW_EMAILS=false

# Check inbox every 60 seconds
INBOX_POLL_INTERVAL_MS=60000

# Internal/API request timeout: 90 seconds
REQUEST_TIMEOUT_MS=90000

# ------------------------------------------------------------
# Experimental / Future Work
# ------------------------------------------------------------

# BL V1 -> BL V2 revision intelligence is an experimental
# extension and is not used by the official SDOC evaluation.
ENABLE_REVISION_INTELLIGENCE=false