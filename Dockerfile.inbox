FROM python:3.12-slim

WORKDIR /app

# Install the official SDOC API dependencies
COPY datasets/sdoc-hackathon-docker/server/requirements.txt ./requirements.txt

RUN pip install --no-cache-dir -r requirements.txt

# Copy official SDOC server code
COPY datasets/sdoc-hackathon-docker/server/app.py ./app.py
COPY datasets/sdoc-hackathon-docker/server/scoring.py ./scoring.py

# Copy participant-safe dataset
COPY cloud-data/ /data/

# Match the organizer server paths
ENV DATA_DIR=/data
ENV GROUND_TRUTH=/secrets/ground_truth.json
ENV REVEAL_GT=0

EXPOSE 8000

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]